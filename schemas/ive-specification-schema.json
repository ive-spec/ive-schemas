{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IVE Base Specification Schema",
  "type": "object",
  "required": ["specification", "views", "intents"],
  "properties": {
    "specification": {
      "type": "object",
      "required": ["schemaVersion", "version"],
      "properties": {
        "schemaVersion": { "type": "string", "enum": ["1.0"] },
        "version": { "type": "string" }
      }
    },
    "views": {
      "type": "object",
      "description": "Diccionario de Views (JSON Schema)",
      "additionalProperties": {
        "type": "object",
        "description": "Definición de una View (debe cumplir con JSON Schema draft 2020-12)"
      }
    },
    "envelopes": {
      "type": "object",
      "description": "Diccionario de Envelopes locales (opcional, se prefieren perfiles del catálogo)",
      "additionalProperties": {
        "type": "object",
        "required": ["requirements"],
        "properties": {
          "requirements": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "errors": {
      "type": "object",
      "description": "Catálogo de errores de dominio",
      "additionalProperties": {
        "type": "object",
        "required": ["condition"],
        "properties": {
          "condition": { "type": "string" },
          "view": { "type": "string" }
        }
      }
    },
    "intents": {
      "type": "object",
      "description": "Diccionario de Intents",
      "additionalProperties": {
        "type": "object",
        "required": ["is", "description"],
        "properties": {
          "is": {
            "type": "string",
            "enum": ["Create", "Update", "Replace", "Delete", "Query"]
          },
          "description": { "type": "string" },
          "view": {
            "type": "object",
            "properties": {
              "input": { "type": "object" },
              "output": { "type": "object" }
            }
          },
          "envelope": {
            "type": "object",
            "properties": {
              "input": { "type": "object" },
              "output": { "type": "object" }
            },
            "additionalProperties": false
          },
          "errors": {
            "type": "array",
            "items": { "type": "object" }
          }
        }
      }
    },
    "flows": {
      "type": "object",
      "description": "Diccionario de Flows (Macro-Intents). Sección opcional: puede no existir en especificaciones sin orquestación multi-step.",
      "additionalProperties": { "$ref": "#/definitions/flow" }
    },
    "extensions": {
      "type": "object",
      "description": "Metadata tecnológica inline (opcional)"
    }
  },
  "definitions": {
    "flow": {
      "type": "object",
      "required": ["description", "steps"],
      "properties": {
        "description": { "type": "string" },
        "view": {
          "type": "object",
          "properties": {
            "input": { "type": "object" },
            "output": { "type": "object" }
          }
        },
        "envelope": {
          "type": "object",
          "properties": {
            "input": { "type": "object" },
            "output": { "type": "object" }
          }
        },
        "errors": {
          "type": "array",
          "items": { "type": "object" }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/step" }
        },
        "onFailure": { "$ref": "#/definitions/rootOnFailure" }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": ["stepId"],
      "properties": {
        "stepId": { "type": "string" },
        "intent": {
          "type": "object",
          "required": ["$ref"],
          "properties": { "$ref": { "type": "string" } }
        },
        "flow": {
          "type": "object",
          "required": ["$ref"],
          "properties": { "$ref": { "type": "string" } }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "dependsOn": {
          "type": "array",
          "items": { "type": "string" }
        },
        "compensate": {
          "type": "object",
          "required": ["intent"],
          "properties": {
            "intent": {
              "type": "object",
              "required": ["$ref"],
              "properties": { "$ref": { "type": "string" } }
            }
          },
          "additionalProperties": false
        },
        "terminatesAs": {
          "type": "string",
          "enum": ["success", "failure"]
        },
        "errorRef": { "type": "string" },
        "onFailure": {
          "type": "array",
          "items": { "$ref": "#/definitions/onFailureRule" }
        }
      },
      "oneOf": [
        { "required": ["intent"], "not": { "required": ["flow"] } },
        { "required": ["flow"], "not": { "required": ["intent"] } }
      ],
      "additionalProperties": false
    },
    "onFailureRule": {
      "type": "object",
      "required": ["criteria", "action"],
      "properties": {
        "criteria": { "type": "string" },
        "action": {
          "type": "string",
          "enum": ["retry", "goto", "continue"]
        },
        "maxAttempts": { "type": "integer", "minimum": 1 },
        "backoff": { "type": "string" },
        "onExhausted": {
          "type": "object",
          "required": ["action", "target"],
          "properties": {
            "action": { "type": "string", "enum": ["goto"] },
            "target": { "type": "string" }
          },
          "additionalProperties": false
        },
        "target": { "type": "string" },
        "skipCompensation": { "type": "boolean", "default": false }
      },
      "if": {
        "properties": { "action": { "const": "retry" } }
      },
      "then": {
        "required": ["onExhausted", "maxAttempts"]
      },
      "additionalProperties": false
    },
    "rootOnFailure": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": { "type": "string", "enum": ["escalate"] },
        "notify": {
          "type": "object",
          "required": ["intent"],
          "properties": {
            "intent": {
              "type": "object",
              "required": ["$ref"],
              "properties": { "$ref": { "type": "string" } }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
