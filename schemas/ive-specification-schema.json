{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IVE Base Specification Schema",
  "type": "object",
  "required": [
    "specification",
    "views",
    "intents"
  ],
  "properties": {
    "specification": {
      "type": "object",
      "required": [
        "schemaVersion",
        "version"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "enum": [
            "1.0"
          ]
        },
        "version": {
          "type": "string"
        }
      }
    },
    "views": {
      "type": "object",
      "description": "Diccionario de Views (JSON Schema)",
      "additionalProperties": {
        "type": "object",
        "description": "Definición de una View (debe cumplir con JSON Schema draft 2020-12)",
        "properties": {
          "identity": {
            "$ref": "#/definitions/identity"
          },
          "mapping": {
            "$ref": "#/definitions/viewMapping"
          },
          "properties": {
            "type": "object",
            "description": "Propiedades de la View. Solo se declaran acá los agregados de IVE; el resto del vocabulario de JSON Schema pasa sin restricción.",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "mapping": {
                  "$ref": "#/definitions/transformChain"
                },
                "protectionExposure": {
                  "$ref": "#/definitions/protectionExposure"
                }
              }
            }
          }
        }
      }
    },
    "envelopes": {
      "type": "object",
      "description": "Diccionario de Envelopes locales (opcional, se prefieren perfiles del catálogo)",
      "additionalProperties": {
        "type": "object",
        "required": [
          "requirements"
        ],
        "properties": {
          "requirements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "errors": {
      "type": "object",
      "description": "Catálogo de errores de dominio",
      "additionalProperties": {
        "type": "object",
        "required": [
          "conditions"
        ],
        "properties": {
          "conditions": {
            "$ref": "#/definitions/conditions"
          },
          "view": {
            "type": "object",
            "required": [
              "$ref"
            ],
            "properties": {
              "$ref": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "intents": {
      "type": "object",
      "description": "Diccionario de Intents",
      "additionalProperties": {
        "type": "object",
        "required": [
          "is",
          "description"
        ],
        "properties": {
          "is": {
            "type": "string",
            "enum": [
              "Create",
              "Update",
              "Replace",
              "Delete",
              "Query"
            ]
          },
          "description": {
            "type": "string"
          },
          "view": {
            "type": "object",
            "properties": {
              "input": {
                "type": "object"
              },
              "output": {
                "type": "object"
              }
            }
          },
          "envelope": {
            "type": "object",
            "properties": {
              "input": {
                "type": "object"
              },
              "output": {
                "type": "object"
              }
            },
            "additionalProperties": false
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/errorRef"
            }
          },
          "trustLevel": {
            "type": "string",
            "description": "Quién invoca, independiente de lo que exija el Envelope. Texto libre: es contra esta clave que resuelve protectionExposure.byTrustLevel de las Views. Sin trustLevel no se aplica ninguna protección por nivel de confianza."
          }
        }
      }
    },
    "flows": {
      "type": "object",
      "description": "Diccionario de Flows (Macro-Intents). Sección opcional: puede no existir en especificaciones sin orquestación multi-step.",
      "additionalProperties": {
        "$ref": "#/definitions/flow"
      }
    },
    "extensions": {
      "type": "object",
      "description": "Metadata tecnológica inline (opcional)"
    }
  },
  "definitions": {
    "identity": {
      "type": "array",
      "description": "Clave natural de negocio de la View: qué propiedades hacen que 'este' registro sea el mismo que otro con los mismos valores. No es un id técnico. Sus propiedades forman parte de required.",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "viewMapping": {
      "type": "object",
      "description": "Cómo se construye esta View a partir de otra. Solo se declara la excepción: lo que coincide en nombre y forma se mapea solo.",
      "properties": {
        "from": {
          "type": "object",
          "description": "La View de origen.",
          "required": [
            "$ref"
          ],
          "properties": {
            "$ref": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "locals": {
          "type": "object",
          "description": "Valores intermedios con nombre propio, referenciables desde cualquier paso igual que una propiedad de origen.",
          "additionalProperties": {
            "$ref": "#/definitions/transformChain"
          }
        }
      },
      "additionalProperties": false
    },
    "transformChain": {
      "type": "object",
      "description": "Una cadena de pasos: el resultado de cada uno alimenta al siguiente.",
      "required": [
        "steps"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/transformStep"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "transformStep": {
      "type": "object",
      "description": "Un paso de transformación. Es puro: no consulta recursos externos — si hace falta ir a buscar un dato afuera, eso es un Flow, no un paso.",
      "required": [
        "operation"
      ],
      "properties": {
        "operation": {
          "type": "string",
          "description": "Nombre de la operación. Las disponibles las declara el catálogo de plataforma (transformOperations), agrupadas por tipo de dato. 'custom' no se cataloga: lleva su propio name."
        },
        "name": {
          "type": "string",
          "description": "Identifica la transformación cuando operation es 'custom'. Quién la implementa es responsabilidad de cada tecnología."
        },
        "from": {
          "type": "array",
          "description": "Propiedades de origen (o locals) que consume el paso, en orden.",
          "items": {
            "type": "string"
          }
        },
        "onNull": {
          "type": "string",
          "description": "Qué hacer si la propiedad de origen no trae valor. Solo aplica a propiedades opcionales: una en required no puede llegar nula.",
          "enum": [
            "propagate",
            "useDefault",
            "omitTarget"
          ]
        }
      }
    },
    "exposureRule": {
      "type": "object",
      "required": [
        "technique"
      ],
      "properties": {
        "technique": {
          "type": "string",
          "enum": [
            "none",
            "mask",
            "hidden"
          ]
        },
        "showLast": {
          "type": "integer",
          "description": "Cuántos caracteres quedan a la vista. Solo tiene sentido con technique: mask.",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "protectionExposure": {
      "type": "object",
      "description": "Cómo tratar el valor de esta propiedad según quién la reciba.",
      "properties": {
        "byTrustLevel": {
          "type": "object",
          "description": "Clave de nivel de confianza → técnica. Las claves son propias de cada organización; IVE no impone ninguna.",
          "additionalProperties": {
            "$ref": "#/definitions/exposureRule"
          }
        },
        "default": {
          "$ref": "#/definitions/exposureRule"
        }
      },
      "additionalProperties": false
    },
    "flow": {
      "type": "object",
      "required": [
        "description",
        "steps"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "view": {
          "type": "object",
          "properties": {
            "input": {
              "type": "object"
            },
            "output": {
              "type": "object"
            }
          }
        },
        "envelope": {
          "type": "object",
          "properties": {
            "input": {
              "type": "object"
            },
            "output": {
              "type": "object"
            }
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/errorRef"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/step"
          }
        },
        "onFailure": {
          "$ref": "#/definitions/rootOnFailure"
        },
        "extensions": {
          "type": "object",
          "description": "Metadata tecnologica del flow, lo mismo que en un Intent. Es lo que le escribe un overlay con un target '$.flows.X.extensions.<tecnologia>' (ver el schema de overlay), y sin esto un flow expuesto por HTTP no puede declarar su path, su metodo ni su operationId: en un Intent eso se infiere de 'is', y un flow no tiene 'is'."
        }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": [
        "stepId"
      ],
      "properties": {
        "stepId": {
          "type": "string"
        },
        "intent": {
          "type": "object",
          "required": [
            "$ref"
          ],
          "properties": {
            "$ref": {
              "type": "string"
            }
          }
        },
        "flow": {
          "type": "object",
          "required": [
            "$ref"
          ],
          "properties": {
            "$ref": {
              "type": "string"
            }
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "object",
          "description": "Only for terminatesAs: success steps — symmetric to errorRef on terminatesAs: failure steps. Maps the flow's own output View fields to expressions ({$steps.X.outputs.Y} / {$view.input.Z}).",
          "additionalProperties": {
            "type": "string"
          }
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "compensate": {
          "type": "object",
          "description": "Como se deshace el efecto de este step. Apunta a un Intent o -para una reversion que necesita varios pasos, manejar sus propios fallos o reintentar- a un Flow, con la misma forma que un step. Exactamente uno de los dos (ver 04-flows.md, decision 4).",
          "oneOf": [
            { "required": ["intent"] },
            { "required": ["flow"] }
          ],
          "properties": {
            "intent": {
              "type": "object",
              "required": [
                "$ref"
              ],
              "properties": {
                "$ref": {
                  "type": "string"
                }
              }
            },
            "flow": {
              "type": "object",
              "description": "Compensacion compleja: se invoca como una unidad, igual que un flow anidado en un step. El flow-padre no orquesta lo que pase adentro.",
              "required": [
                "$ref"
              ],
              "properties": {
                "$ref": {
                  "type": "string"
                }
              }
            },
            "inputs": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "terminatesAs": {
          "type": "string",
          "enum": [
            "success",
            "failure"
          ]
        },
        "errorRef": {
          "type": "string"
        },
        "onFailure": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/onFailureRule"
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "intent"
          ],
          "not": {
            "required": [
              "flow"
            ]
          }
        },
        {
          "required": [
            "flow"
          ],
          "not": {
            "required": [
              "intent"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "onFailureRule": {
      "type": "object",
      "required": [
        "criteria",
        "action"
      ],
      "properties": {
        "criteria": {
          "type": "string"
        },
        "action": {
          "type": "string",
          "enum": [
            "retry",
            "goto",
            "continue"
          ]
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1
        },
        "backoff": {
          "type": "string"
        },
        "onExhausted": {
          "type": "object",
          "required": [
            "action",
            "target"
          ],
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "goto"
              ]
            },
            "target": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "target": {
          "type": "string"
        },
        "skipCompensation": {
          "type": "boolean",
          "default": false
        }
      },
      "if": {
        "properties": {
          "action": {
            "const": "retry"
          }
        }
      },
      "then": {
        "required": [
          "onExhausted",
          "maxAttempts"
        ]
      },
      "additionalProperties": false
    },
    "rootOnFailure": {
      "type": "object",
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "escalate"
          ]
        },
        "notify": {
          "type": "object",
          "required": [
            "intent"
          ],
          "properties": {
            "intent": {
              "type": "object",
              "required": [
                "$ref"
              ],
              "properties": {
                "$ref": {
                  "type": "string"
                }
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "conditions": {
      "type": "object",
      "description": "Causas por las que puede darse este error. La CLAVE es un identificador estable, la que usa el codigo generado para referirse a una causa puntual (enum, constante); el MENSAJE es el texto con el que el error se lanza en runtime, y puede reescribirse (redaccion, traduccion) sin romper nada que lo referencie. Misma forma en el catalogo y en el Intent: si un Intent declara una condicion cuya clave YA existe en la entrada del catalogo, es el mismo error y no se agrega nada; si la clave es nueva, es una causa propia de la logica del Intent y convive con la del catalogo bajo el mismo codigo HTTP.",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-zA-Z0-9]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "errorRef": {
      "type": "object",
      "description": "Referencia a una entrada del catalogo de errores, con las condiciones propias del Intent si las tiene.",
      "required": [
        "$ref"
      ],
      "properties": {
        "$ref": {
          "type": "string"
        },
        "conditions": {
          "$ref": "#/definitions/conditions"
        }
      },
      "additionalProperties": false
    }
  }
}
